datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String   @id @default(uuid())
  nome          String
  email         String   @unique
  senha         String
  matricula     String?  @unique
  equipe        String
  cargo         String
  turma         String   @default("A")
  horarioTurno  String?  @default("07:00 às 19:00")
  periodoTurno  String?  @default("Dia")
  criadoPor     String?
  criadoEm      DateTime @default(now())
  shifts        Shift[]   @relation("ResponsavelShift")
  leaderMessages  LeaderMessage[] @relation("SenderUser")
  operatorReplies OperatorReply[] @relation("ReplyUser")
}

model Shift {
  id                             String          @id @default(uuid())
  equipe                         String          // Automação A, Automação B, Automação C
  turma                          String?         @default("A") // Turma A, B, C, D
  tipoTurno                      String?         @default("Diurno") // Diurno, Noturno
  escala                         String?         @default("2x3") // 2x3, 4x3, 3x2
  ausencias                      String?         // ex: Baia (férias)
  monitoramento                  String?         // Nome do monitor/responsável do CCO
  horarioTurno                   String?         @default("07h às 19h") // ex: 07h às 19h, 19h às 07h
  responsavelId                  String?
  responsavel                    User?           @relation("ResponsavelShift", fields: [responsavelId], references: [id])
  responsavelNome                String
  data                           String          // YYYY-MM-DD
  horaInicio                     DateTime        @default(now())
  horaFim                        DateTime?
  status                         String          @default("ATIVO") // ATIVO, ENCERRADO
  observacoes                    String?

  // Equipes em campo (OneNote)
  liderVale                      String?         // ex: Vinicius
  equipeSonda                    String?         // ex: Valdenir, Gustavo, Vitor
  equipeContratadas              String?         // ex: Railton (Flanders), Igor (COM3), Marcos e Gustavo (ALCON), Tarcisio (Creare ADM)

  // Checklist FMDS & Rotina Diária (OneNote)
  fmdsChecklist                  String?         // JSON com estado dos itens de FMDS
  equipamentosSemDespacho        String?         // ex: EC10, PZ15, PZ20, PZ21, PZ42, PZ43, TT52, TT53, TT81, TT84
  equipamentosSemGps             String?         // ex: TT57, TT92
  equipamentosPreventiva         String?         // ex: EC17, PZ02, TT84, TT85
  equipamentosManutencao         String?         // ex: PZ14, PZ47, TT56

  checklistMalaoStatus           String?         @default("Realizado")
  checklistMalaoFaltantes        String?
  checklistMalaoResponsavel      String?
  solicitacaoMaterialStatus      String?
  solicitacaoMaterialResponsavel String?
  anomaliasIdentificadas         String?
  incidents                      Incident[]
  handoversSaida                 ShiftHandover[] @relation("TurnoSaida")
  handoversEntrada                ShiftHandover[] @relation("TurnoEntrada")
  criadoEm                       DateTime        @default(now())
}

model Equipment {
  id               String     @id @default(uuid())
  tag              String     @unique // ex: CAT-793D-05, EX-5500-01, PR-08
  nome             String     // ex: Caminhão Fora de Estrada, Escavadeira Hidráulica
  tipo             String     // Caminhão, Escavadeira, Perfuratriz, Trator, Carregadeira, Motoniveladora, Outros
  area             String     // Frota Mina, Praça de Carga, Infraestrutura, Usina
  horimetroOpcional Float?
  incidents        Incident[]
  criadoEm         DateTime   @default(now())
}

model Incident {
  id                      String          @id @default(uuid())
  equipmentId             String?
  equipment               Equipment?      @relation(fields: [equipmentId], references: [id])
  tag                     String
  equipamentoNome         String
  area                    String
  tipoFalha               String          // Comunicação, PLC, Inversor, Instrumentação, Rede Industrial, Sensor, Supervisório, Outro
  falha                   String
  sintoma                 String?
  dataHoraParada          DateTime
  dataHoraAcionamento     DateTime?       // OneNote: Hora do acionamento
  previsaoLiberacao       String?         // OneNote: Previsão de liberação (ex: 15:30)
  dataHoraLiberacao       DateTime?
  prioridade              String          @default("MEDIA") // BAIXA, MEDIA, ALTA, CRITICA
  status                  String          @default("EM_ANDAMENTO") // EM_ANDAMENTO, AGUARDANDO, FINALIZADO, PENDENCIA_PROXIMO_TURNO
  responsavelId           String?
  responsavel             String
  solucao                 String?
  motivoEspera            String?
  proximaAcao             String?
  localizacaoAtualOpcional String?
  observacao              String?
  shiftId                 String?
  shift                   Shift?          @relation(fields: [shiftId], references: [id])
  isPendenciaHerdada      Boolean         @default(false)
  historico               IncidentHistory[]
  criadoEm                DateTime        @default(now())
  atualizadoEm            DateTime        @updatedAt
}

model IncidentHistory {
  id         String   @id @default(uuid())
  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  tipoEvento String   @default("ATUALIZACAO") // ABERTURA, ATUALIZACAO, ALTERACAO_STATUS, SOLUCAO, LIBERACAO, TRANSFERENCIA_TURNO
  descricao  String
  usuario    String
  dataHora   DateTime @default(now())
}

model ShiftHandover {
  id                             String   @id @default(uuid())
  turnoAnteriorId                String
  turnoAnterior                  Shift    @relation("TurnoSaida", fields: [turnoAnteriorId], references: [id])
  turnoNovoId                    String?
  turnoNovo                      Shift?   @relation("TurnoEntrada", fields: [turnoNovoId], references: [id])
  dataHora                       DateTime @default(now())
  responsavelSaida               String
  responsavelEntrada             String?
  turma                          String?
  monitoramento                  String?
  horarioTurno                   String?
  checklistMalaoStatus           String?
  checklistMalaoFaltantes        String?
  checklistMalaoResponsavel      String?
  solicitacaoMaterialStatus      String?
  solicitacaoMaterialResponsavel String?
  anomaliasIdentificadas         String?
  observacoes                    String?
  resumoFinalizados              String   // JSON string
  resumoPendencias               String   // JSON string
  prioridades                    String   // JSON string
}

model LeaderMessage {
  id          String   @id @default(uuid())
  sender      String
  senderId    String?
  senderUser  User?    @relation("SenderUser", fields: [senderId], references: [id])
  targetTurma String   // 'A' | 'B' | 'C' | 'D' | 'GERAL'
  text        String
  criadoEm    DateTime @default(now())
}

model OperatorReply {
  id        String   @id @default(uuid())
  sender    String
  senderId  String?
  senderUser User?   @relation("ReplyUser", fields: [senderId], references: [id])
  fromTurma String   // 'A' | 'B' | 'C' | 'D'
  text      String
  criadoEm  DateTime @default(now())
}
